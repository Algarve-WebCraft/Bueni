---
title: 'Bueni | Authentic Lagos Restaurant'
bodyClass: 'home loading'
---

{% extends "base.njk" %}

{% block content %}

<!------------------------------------------------------------------------------------------------------------>
<!--------------------------------------- PAGE 1 / HERO-SECTION ---------------------------------------------->
<!------------------------------------------------------------------------------------------------------------>

<section class="cmp-light-section cmp-hero-section" aria-labelledby="main-hero-heading">
  <div class="wrapper">
    <div class="cmp-hero-section__image transition-hero-shutter"></div>

    <div class="cmp-page-hero-flex">
      <div>
        <h1 id="main-hero-heading" class="cmp-hero-heading transition-fade">Rooted in tradition <span class="cmp-hero-heading-span">modern in taste</span></h1>
      </div>
      
      <div class="hero-flex__inner-flex">
        <div class="hero-flex__inner__inner-flex transition-slide-opposite">
          <a href="/contact" class="cmp-main-btn">Book a table</a>
          <a href="/menu" class="cmp-secondary-btn">Explore the menu</a>
        </div>
      </div>
    </div>

  </div>
</section>

<!---------------------------------------------------------------------------------------------------------------->
<!--------------------------------------- PAGE 1 / SECTION-ONE / INTRODUCTION ------------------------------------>
<!---------------------------------------------------------------------------------------------------------------->

<section class="cmp-light-section transition-reverse-slide" aria-labelledby="intro-heading">
  <div class="wrapper wrapper--mobile-s">

    <div class="intro-container" data-animate-group data-animate-start="top 45%">
      <div class="intro__text-container" data-animate="fade-in">
        <h2 id="intro-heading" class="cmp-main-heading">Where innovation meets tradition</h2>
        <p class="cmp-main-text cmp-main-text-margins">At the heart of every dish is a respect for time-honored techniques, paired with a curiosity for new ideas. Our kitchen draws inspiration from the past while embracing fresh influences, bringing together classic foundations and thoughtful creativity. Each plate is crafted with care, resulting in food that feels familiar, refined, and quietly distinctive.</p>
        <div class="intro__text-container__button">
          <a href="/about" class="cmp-secondary-btn">Discover our history</a>
        </div>
      </div>

      <div class="intro-image-container">
        <img src="/assets/images/bueni-3.jpg" alt="foood" data-animate="slide-left">
        <img src="/assets/images/bueni-4.jpg" alt="foood" data-animate="slide-up">
        <img src="/assets/images/bueni-2.jpg" alt="foood" data-animate="slide-right">
      </div>
      <p class="cmp-main-text" data-animate="fade-in">We cook with intention, letting tradition set the pace while modern influences guide the direction. Time-tested methods form the foundation, while contemporary influences add nuance and depth. The result is food that feels familiar yet surprising, crafted to be enjoyed slowly and remembered long after.</p>
    </div>

  </div>
</section>

<!------------------------------------------------------------------------------------------------------------>
<!--------------------------------------- PAGE 1 / SECTION-TWO / MENU ---------------------------------------->
<!------------------------------------------------------------------------------------------------------------>

<section class="cmp-dark-section transition-reverse-slide" aria-labelledby="menu-heading">
  <div class="wrapper wrapper--mobile-mini">

    <div class="menu-text-container" data-animate="scale-size">
      <h2 id="menu-heading" class="cmp-main-heading-white">Explore our <br> menu</h2>
      <p class="cmp-main-text-white cmp-main-text-margins">Our menu combines fresh, high-quality ingredients with vibrant flavors, creating dishes that delight with every bite</p>
    </div>

    <div class="menu-grid-container">
      <a href="/menu/#starters">
        <div class="menu-grid__inner">
          <div class="menu-grid__inner-image" data-animate="shutter-horizontal"> 
            <img src="/assets/images/bueni-test-4.jpg" alt="Some food.">
          </div>
          <div>
            <h3 class="cmp-micro-heading">Starters</h3>
            <p class="cmp-main-text-white">Seasonal small plates to share or savor solo.</p>
          </div>
        </div>
      </a>

      <a href="/menu/#mains">
        <div class="menu-grid__inner">
          <div class="menu-grid__inner-image" data-animate="shutter-horizontal"> 
            <img src="/assets/images/bueni-test-5.png" alt="Some food.">
          </div>
          <div>
            <h3 class="cmp-micro-heading">Mains</h3>
            <p class="cmp-main-text-white">Hearty dishes rooted in classic technique.</p>
          </div>
        </div>
      </a>

      <a href="/menu/#desserts">
        <div class="menu-grid__inner">
          <div class="menu-grid__inner-image" data-animate="shutter-horizontal"> 
            <img src="/assets/images/bueni-test-6.png" alt="Some food.">
          </div>
          <div>
            <h3 class="cmp-micro-heading">Desserts</h3>
            <p class="cmp-main-text-white">Sweet finishes, both bold and nostalgic.</p>
          </div>
         </div>
      </a>

      <a href="/menu/#drinks">
        <div class="menu-grid__inner">
           <div class="menu-grid__inner-image" data-animate="shutter-horizontal"> 
            <img src="/assets/images/bueni-test-7.png" alt="Some food.">
          </div>
          <div>
            <h3 class="cmp-micro-heading">Drinks</h3>
            <p class="cmp-main-text-white">Crafted cocktails, wines, and soft pairings.</p>
          </div>
        </div>
       </a>
    </div>

  </div>
</section>

<!------------------------------------------------------------------------------------------------------------>
<!--------------------------------------- PAGE 1 / SECTION-THREE / GALLERY ----------------------------------->
<!------------------------------------------------------------------------------------------------------------>

<section class="cmp-light-section transition-reverse-slide" aria-labelledby="gallery-heading">
  <div class="wrapper wrapper--mobile-s">

    <div class="gallery-section-container">
      <div class="gallery-text-container" data-animate="scale-size">
        <h2 id="gallery-heading" class="cmp-main-heading">Moments shared together</h2>
        <p class="cmp-main-text cmp-main-text-margins">A look inside the space, and the details that shape the food and experience. Our gallery captures the atmosphere of the restaurant and our dishes, as they are meant to be enjoyed, offering a sense of the setting and the moments shared around the table.</p>
        <a class="cmp-secondary-btn" href="/gallery">Gallery</a>
      </div>

      <div class="gallery-grid-container" data-animate-group>
        <img src="/assets/images/bueni-14.jpg" alt="Some food." data-animate="slide-down">
        <img src="/assets/images/bueni-10.jpg" alt="Some food." data-animate="slide-right">
        <img src="/assets/images/bueni-18.jpg" alt="Some food." data-animate="slide-left">
        <img src="/assets/images/bueni-16.jpg" alt="Some food." data-animate="slide-up">
      </div>
    </div>

  </div>
</section>

<!------------------------------------------------------------------------------------------------------------>
<!--------------------------------------- PAGE 1 / SECTION-FOUR / EXTRA INFO --------------------------------->
<!------------------------------------------------------------------------------------------------------------>

<section class="extra-info-section cmp-dark-section transition-reverse-slide" aria-labelledby="extra-heading">
  <div class="wrapper">

    <div class="extra-flex-container">
      <div class="extra-flex__text-container" data-animate="slide-left">
        <h2 id="extra-heading" class="cmp-main-heading-white">Catering for any celebration</h2>
        <p class="cmp-main-text-white cmp-main-text-margins">Whether you are planning an intimate gathering or a larger celebration, our restaurant provides a welcoming setting and a thoughtfully crafted experience. With a focus on unique flavours and attentive service, it is a place well suited for a wide range of occasions, from personal milestones to group events and shared celebrations.</p>
      </div>

      <div class="extra-flex__image-container" data-animate="scale"></div>
    </div>

  </div>
</section>

<!------------------------------------------------------------------------------------------------------------>
<!----------------------------------------- PAGE 1 / SECTION-FIVE / CONTACT ---------------------------------->
<!------------------------------------------------------------------------------------------------------------>

<section class="cmp-light-section contact-section contact-section--no-divide transition-reverse-slide" aria-labelledby="contact-heading">
  <div class="contact-image" data-animate="shutter-horizontal"></div>
  <div class="wrapper wrapper--mobile-m">

    <div class="contact-flex-container">
      <h2 id="contact-heading" class="cmp-main-heading contact-heading" data-animate="slide-left">We're here to<span class="cmp-hero-heading-span">welcome you</span></h2>

      <div class="contact-flex__text-container" data-animate="scale-size">
        <div class="contact-text-container__inner-flex">
          <h3 class="cmp-micro-heading">Opening hours</h3>
          <span class="cmp-main-text">Monday: 6AM - 11PM</span>
          <span class="cmp-main-text">Tuesday: 6AM - 11PM</span>
          <span class="cmp-main-text">Wednesday: CLOSED</span>
          <span class="cmp-main-text">Thursday: 6AM - 11PM</span>
          <span class="cmp-main-text">Friday: 6AM - 11PM</span>
          <span class="cmp-main-text">Saturday: 6AM - 11PM</span>
          <span class="cmp-main-text">Sunday: 6AM - 11PM</span>
        </div>

        <div class="contact-text-container__inner-flex">
          <h3 class="cmp-micro-heading">Find us</h3>
          <a class="cmp-main-text" href="https://maps.app.goo.gl/dBj8uBxUn3Pg4NLE6" target="_blank" rel="noopener">
            Rua da Laranjeira 1,<br> 8600-697 Lagos
          </a>
          <a class="cmp-main-text" href="tel:+351282113593">
            +351 282 113 593
          </a>
          <a class="cmp-main-text" href="mailto:buenilagos@gmail.com?subject=Restaurant%20Enquiry">
            buenilagos@gmail.com
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}