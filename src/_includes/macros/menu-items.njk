{% macro menuItems(items) %}
  {% for item in items %}
    <div class="menu-items__selection" data-animate="{{ item.animate }}">
      <img src="{{ item.image }}" alt="{{ item.alt }}">
      <div class="menu-items__selection__text-container">
        <div class="menu-items__selection__text-container__inner">
          <h3 class="cmp-main-text">{{ item.name }}</h3>
          <span>{{ item.price }}</span>
        </div>
        <p class="cmp-main-text">{{ item.description }}</p>
      </div>
    </div>
  {% endfor %}
{% endmacro %}