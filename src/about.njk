<!--------------------------------------- PAGE 2 / SECTION-ONE / HERO ---------------------------------------->
<!------------------------------------------------------------------------------------------------------------>

<section class="cmp-light-section cmp-hero-section" aria-labelledby="about-hero-heading">
  <div class="wrapper">
    <div class="cmp-hero-section__image cmp-hero-section__image--pg2-s1 transition-hero-shutter"></div>

    <div class="cmp-page-hero-flex">
      <div>
        <h1 id="about-hero-heading" class="cmp-hero-heading transition-fade">The story behind<span class="cmp-hero-heading-span">the kitchen</span></h1>
      </div>
    </div>

  </div>
</section>

<!------------------------------------------------------------------------------------------------------------>
<!--------------------------------------- PAGE 2 / SECTION-TWO / HISTORY ------------------------------------->
<!------------------------------------------------------------------------------------------------------------>

<section class="cmp-light-section cmp-dark-mode-section transition-reverse-slide" aria-labelledby="history-heading">
  <div class="wrapper wrapper--narrow-m wrapper--mobile-s wrapper--tablet-l">

    <div class="about-container">
      <div class="about-text-container" data-animate="scale-size">
        <h2 id="history-heading" class="cmp-main-heading">From Humble Beginnings</h2>
        <p class="cmp-main-text cmp-main-text-margins">Founded over a decade ago, our restaurant began as a small family endeavor with a passion for quality ingredients and traditional recipes. Over the years, we have grown while staying true to our roots, blending classic techniques with modern flavors to create a dining experience that delights every guest. <br><br> Founded over a decade ago, our restaurant began as a small family endeavor with a passion for quality ingredients and traditional recipes. Over the years, we have grown while staying true to our roots, blending classic techniques with modern flavors to create a dining experience that delights every guest. <br><br> Founded over a decade ago, our restaurant began as a small family endeavor with a passion for quality ingredients and traditional recipes. Over the years, we have grown while staying true to our roots, blending classic techniques with modern flavors to create a dining experience that delights every guest.</p>
      </div>

      <div class="about-image-container" data-animate-group data-animate-start="top 50%">
        <img src="/assets/images/bueni-15.jpg" alt="" data-animate="slide-left">
        <img src="/assets/images/bueni-8.jpg" alt="" data-animate="slide-right">
        <img src="/assets/images/bueni-17.webp" alt="" data-animate="slide-up">
      </div>
    </div>

  </div>
</section>

